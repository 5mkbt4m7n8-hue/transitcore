{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:intransit:map-studio:display-stations:v0.3",
  "title": "Proposed optional InTransit display-station model",
  "description": "Draft specification only; cross-references to maps, Quays and hardware require application-level validation.",
  "type": "object",
  "required": [
    "schemaVersion",
    "stops",
    "paths"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "stops": {
      "type": "array"
    },
    "paths": {
      "type": "array"
    },
    "displayStationsVersion": {
      "const": 1
    },
    "displayStations": {
      "type": "array",
      "maxItems": 3000,
      "items": {
        "$ref": "#/$defs/displayStation"
      }
    }
  },
  "dependentRequired": {
    "displayStations": [
      "displayStationsVersion"
    ],
    "displayStationsVersion": [
      "displayStations"
    ]
  },
  "additionalProperties": true,
  "$defs": {
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 913
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1280
        }
      },
      "additionalProperties": false
    },
    "offset": {
      "type": "object",
      "required": [
        "along",
        "across"
      ],
      "properties": {
        "along": {
          "type": "number",
          "minimum": -300,
          "maximum": 300
        },
        "across": {
          "type": "number",
          "minimum": -300,
          "maximum": 300
        }
      },
      "additionalProperties": false
    },
    "trackAnchor": {
      "type": "object",
      "required": [
        "pathId",
        "segmentIndex",
        "orientation"
      ],
      "properties": {
        "pathId": {
          "type": "string",
          "minLength": 1
        },
        "segmentIndex": {
          "type": "integer",
          "minimum": 0
        },
        "orientation": {
          "enum": [
            "follow-tangent",
            "manual"
          ]
        },
        "angleDegrees": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        }
      },
      "additionalProperties": false
    },
    "stationStyle": {
      "type": "object",
      "required": [
        "type",
        "markerRadius",
        "ringPadding",
        "ringWidth"
      ],
      "properties": {
        "type": {
          "enum": [
            "single",
            "single_ring",
            "double",
            "double_outer_ring",
            "double_capsule",
            "interchange",
            "terminus"
          ]
        },
        "outerShape": {
          "enum": [
            "circle",
            "ellipse",
            "capsule"
          ]
        },
        "markerRadius": {
          "type": "number",
          "minimum": 2,
          "maximum": 20
        },
        "ringPadding": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        },
        "ringWidth": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 10
        }
      },
      "additionalProperties": false
    },
    "label": {
      "type": "object",
      "required": [
        "mode",
        "sourceMapStopId"
      ],
      "properties": {
        "mode": {
          "enum": [
            "shared",
            "separate"
          ]
        },
        "sourceMapStopId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "required": [
        "id",
        "mapStopId",
        "quayId",
        "slot",
        "offset",
        "placementReview"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mapStopId": {
          "type": "string",
          "minLength": 1
        },
        "quayId": {
          "type": "string",
          "pattern": "^NSR:Quay:[0-9]+$"
        },
        "slot": {
          "enum": [
            "a",
            "b",
            "center",
            "custom"
          ]
        },
        "offset": {
          "$ref": "#/$defs/offset"
        },
        "placementReview": {
          "enum": [
            "unreviewed",
            "user-reviewed"
          ]
        }
      },
      "additionalProperties": false
    },
    "displayStation": {
      "type": "object",
      "required": [
        "id",
        "anchor",
        "style",
        "label",
        "members",
        "reviewStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "$ref": "#/$defs/point"
        },
        "trackAnchor": {
          "$ref": "#/$defs/trackAnchor"
        },
        "style": {
          "$ref": "#/$defs/stationStyle"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/member"
          }
        },
        "reviewStatus": {
          "enum": [
            "unreviewed",
            "user-reviewed"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
